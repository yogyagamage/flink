    options.addOption(REMOVE_KEY_VALUE_OPTION);
    options.addOption(REPLACE_KEY_VALUE_OPTION);
    options.addOption(DYNAMIC_PROPERTY_OPTION);
    options.addOption(FLATTEN_CONFIG_OPTION);
    return options;
}

