@Override
public EntrypointClusterConfiguration createResult(@Nonnull
CommandLine commandLine) {
    final String configDir = commandLine.getOptionValue(CONFIG_DIR_OPTION.getOpt());
    final Properties dynamicProperties = commandLine.getOptionProperties(DYNAMIC_PROPERTY_OPTION.getOpt());
    return new EntrypointClusterConfiguration(configDir, dynamicProperties, commandLine.getArgs());
}

