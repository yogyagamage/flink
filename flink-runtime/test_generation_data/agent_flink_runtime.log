package org.apache.flink.runtime.security.modules;

import org.apache.flink.configuration.Configuration;
import org.apache.flink.runtime.security.SecurityConfiguration;
import org.apache.flink.runtime.security.token.hadoop.KerberosLoginProvider;
import org.apache.hadoop.conf.Configuration as HadoopConfiguration;
import org.apache.hadoop.security.Credentials;
import org.apache.hadoop.security.UserGroupInformation;
import org.junit.jupiter.api.Test;
import java.io.File;
import java.io.IOException;
import java.lang.reflect.Field;
import java.util.concurrent.Executors;
import java.util.concurrent.ScheduledExecutorService;

class HadoopModuleinstall_UserGroupInformationaddCredentialsFikaTest {

    @Test
    void testInstallTriggersAddCredentials() throws Exception {
        // Create minimal Flink configuration
        Configuration flinkConfig = new Configuration();
        SecurityConfiguration securityConfig = new SecurityConfiguration(flinkConfig);
        
        // Create Hadoop configuration
        HadoopConfiguration hadoopConfig = new HadoopConfiguration();
        
        // Create the module instance
        HadoopModule module = new HadoopModule(securityConfig, hadoopConfig);
        
        // Set up environment variable to trigger the credentials path
        String tempTokenFile = createTempTokenFile();
        try {
            // Set the environment variable that HadoopModule checks
            setEnv(UserGroupInformation.HADOOP_TOKEN_FILE_LOCATION, tempTokenFile);
            
            // Mock KerberosLoginProvider to return true for isLoginPossible
            // This is necessary to reach the addCredentials call
            KerberosLoginProvider mockProvider = createMockKerberosLoginProvider();
            setPrivateField(module, "securityConfig", createSecurityConfigWithMockProvider(securityConfig, mockProvider));
            
            // Call the entry point
            module.install();
        } finally {
            // Clean up
            if (tempTokenFile != null) {
                new File(tempTokenFile).delete();
            }
        }
    }
    
    private String createTempTokenFile() throws IOException {
        File tempFile = File.createTempFile("test_token", ".bin");
        tempFile.deleteOnExit();
        
        // Create minimal credentials file that can be read by Credentials.readTokenStorageFile
        Credentials credentials = new Credentials();
        // Write credentials to file
        credentials.writeTokenStorageFile(tempFile, new HadoopConfiguration());
        
        return tempFile.getAbsolutePath();
    }
    
    private void setEnv(String key, String value) throws Exception {
        try {
