package org.apache.flink.runtime.io.network.partition.consumer;

import org.apache.flink.runtime.clusterframework.types.ResourceID;
import org.apache.flink.runtime.deployment.InputGateDeploymentDescriptor;
import org.apache.flink.runtime.io.network.ConnectionManager;
import org.apache.flink.runtime.io.network.TaskEventPublisher;
import org.apache.flink.runtime.io.network.buffer.NetworkBufferPool;
import org.apache.flink.runtime.io.network.metrics.InputChannelMetrics;
import org.apache.flink.runtime.io.network.partition.PartitionProducerStateProvider;
import org.apache.flink.runtime.io.network.partition.ResultPartitionManager;
import org.apache.flink.runtime.shuffle.ShuffleIOOwnerContext;
import org.apache.flink.runtime.taskmanager.NettyShuffleEnvironmentConfiguration;
import org.apache.flink.configuration.Configuration;
import org.apache.flink.configuration.NettyShuffleEnvironmentOptions;
import org.apache.flink.runtime.io.network.partition.hybrid.tiered.common.TieredStorageConfiguration;
import org.apache.flink.runtime.io.network.partition.hybrid.tiered.netty.TieredStorageNettyServiceImpl;
import org.apache.commons.lang3.tuple.Pair;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.IOException;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyInt;

public class SingleInputGateFactorycreateBufferPoolFactory_PairofFikaTest {

    @Test
    public void testCreateInvokesPairOf() throws IOException {
        // Create mocks for constructor dependencies
        ResourceID taskExecutorResourceId = new ResourceID("test-resource");
        NettyShuffleEnvironmentConfiguration networkConfig = createNetworkConfig();
        ConnectionManager connectionManager = Mockito.mock(ConnectionManager.class);
        ResultPartitionManager partitionManager = Mockito.mock(ResultPartitionManager.class);
        TaskEventPublisher taskEventPublisher = Mockito.mock(TaskEventPublisher.class);
        NetworkBufferPool networkBufferPool = Mockito.mock(NetworkBufferPool.class);
        TieredStorageConfiguration tieredStorageConfiguration = null;
        TieredStorageNettyServiceImpl tieredStorageNettyService = null;

        // Instantiate the class under test
        SingleInputGateFactory factory = new SingleInputGateFactory(
                taskExecutorResourceId,
                networkConfig,
                connectionManager,
                partitionManager,
                taskEventPublisher,
                networkBufferPool,
                tieredStorageConfiguration,
                tieredStorageNettyService
        );

        // Create mocks for the create method parameters
        ShuffleIOOwnerContext owner = Mockito.mock(ShuffleIOOwnerContext.class);
        Mockito.when(owner.getOwnerName()).thenReturn("test-owner");
        Mockito.when(owner.getInputGroup()).thenReturn(Mockito.mock(org.apache.flink.metrics.MetricGroup.class));

        int gateIndex = 0;
        
        InputGateDeploymentDescriptor igdd = Mockito.mock(InputGateDeploymentDescriptor.class);
        Mockito.when(igdd.getConsumedPartitionType()).thenReturn(org.apache.flink.runtime.io.network.partition.ResultPartitionType.PIPELINED);
        Mockito.when(igdd.getNumConsumedShuffleDescriptors()).thenReturn(1);
        Mockito.when(igdd.getConsumedResultId()).thenReturn(new org.apache.flink.runtime.jobgraph.IntermediateDataSetID());
        Mockito.when(igdd.getConsumedSubpartitionRange(anyInt())).thenReturn(new org.apache.flink.runtime.io.network.partition.ResultSubpartitionIndexSet(0));
        Mockito.when(igdd.getConsumedShuffleDescriptorRanges()).thenReturn(
                new org.apache.flink.runtime.executiongraph.IndexRange[]{new org.apache.flink.runtime.executiongraph.IndexRange(0, 0)}
        );
        Mockito.when(igdd.getShuffleDescriptors()).thenReturn(
                new org.apache.flink.runtime.shuffle.ShuffleDescriptor[]{
                        Mockito.mock(org.apache.flink.runtime.shuffle.ShuffleDescriptor.class)
                }
        );

        PartitionProducerStateProvider partitionProducerStateProvider = 
                Mockito.mock(PartitionProducerStateProvider.class);
        InputChannelMetrics metrics = Mockito.mock(InputChannelMetrics.class);

        // Invoke the entry point method
        factory.create(owner, gateIndex, igdd, partitionProducerStateProvider, metrics);
    }

    private NettyShuffleEnvironmentConfiguration createNetworkConfig() {
        Configuration config = new Configuration();
        config.setInteger(NettyShuffleEnvironmentOptions.NETWORK_BUFFERS_PER_CHANNEL, 2);
        config.setInteger(NettyShuffleEnvironmentOptions.FLOATING_BUFFERS_PER_GATE, 8);
        config.setInteger(NettyShuffleEnvironmentOptions.NETWORK_REQUEST_BACKOFF_INITIAL, 100);
        config.setInteger(NettyShuffleEnvironmentOptions.NETWORK_REQUEST_BACKOFF_MAX, 1000);
        config.setInteger(NettyShuffleEnvironmentOptions.NETWORK_BUFFER_SIZE, 32768);
        config.setBoolean(NettyShuffleEnvironmentOptions.BATCH_SHUFFLE_COMPRESSION_ENABLED, false);
        config.setString(NettyShuffleEnvironmentOptions.SHUFFLE_COMPRESSION_CODEC, "LZ4");
        
        return NettyShuffleEnvironmentConfiguration.fromConfiguration(
                config,
                Mockito.mock(org.apache.flink.core.memory.MemorySegmentProvider.class),
                false
        );
    }
}

