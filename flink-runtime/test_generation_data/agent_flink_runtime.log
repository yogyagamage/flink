package org.apache.flink.runtime.security.modules;

import org.apache.flink.configuration.Configuration;
import org.apache.flink.runtime.security.SecurityConfiguration;
import org.apache.hadoop.conf.Configuration as HadoopConfiguration;
import org.apache.hadoop.security.UserGroupInformation;
import org.junit.jupiter.api.Test;
import java.io.File;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;

public class HadoopModuleinstall_UserGroupInformationaddCredentialsFikaTest {

    @Test
    public void testInstallTriggersAddCredentials() throws Exception {
        SecurityConfiguration securityConfig = createSecurityConfiguration();
        HadoopConfiguration hadoopConfig = createHadoopConfiguration();
        
        HadoopModule hadoopModule = new HadoopModule(securityConfig, hadoopConfig);
        
        setupEnvironmentForKerberosLogin();
        
        hadoopModule.install();
    }
    
    private SecurityConfiguration createSecurityConfiguration() {
        Configuration flinkConfig = new Configuration();
        flinkConfig.setBoolean(org.apache.flink.configuration.SecurityOptions.DELEGATION_TOKENS_ENABLED, false);
        return new SecurityConfiguration(flinkConfig);
    }
    
    private HadoopConfiguration createHadoopConfiguration() {
        HadoopConfiguration hadoopConfig = new HadoopConfiguration();
        hadoopConfig.set("hadoop.security.authentication", "kerberos");
        return hadoopConfig;
    }
    
    private void setupEnvironmentForKerberosLogin() throws IOException {
        Path tempTokenFile = Files.createTempFile("token", ".bin");
        tempTokenFile.toFile().deleteOnExit();
        
        System.setProperty("java.security.krb5.conf", createDummyKrb5Conf());
        System.setProperty("javax.security.auth.useSubjectCredsOnly", "false");
        
        System.setenv(UserGroupInformation.HADOOP_TOKEN_FILE_LOCATION, tempTokenFile.toString());
        
        UserGroupInformation.setConfiguration(new HadoopConfiguration());
    }
    
    private String createDummyKrb5Conf() {
        try {
            Path krb5Conf = Files.createTempFile("krb5", ".conf");
            Files.writeString(krb5Conf, 
                "[libdefaults]\n" +
                "default_realm = EXAMPLE.COM\n" +
                "dns_lookup_kdc = false\n" +
                "[realms]\n" +
                "EXAMPLE.COM = {\n" +
                "  kdc = kdc.example.com\n" +
                "}\n" +
                "[domain_realm]\n" +
                ".example.com = EXAMPLE.COM\n" +
                "example.com = EXAMPLE.COM\n");
            krb5Conf.toFile().deleteOnExit();
            return krb5Conf.toString();
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
    }
}

