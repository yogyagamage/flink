public static List<String> loadAndModifyConfiguration(String[] args) throws FlinkException {
    return // PATH: Test should invoke the next FlinkConfigLoader.filterCmdArgs(...) [step in execution path]
    ConfigurationParserUtils.loadAndModifyConfiguration(filterCmdArgs(args, ModifiableClusterConfigurationParserFactory.options()), BashJavaUtils.class.getSimpleName());
}

private static String[] filterCmdArgs(String[] args, Options options) {
    final List<String> filteredArgs = new ArrayList<>();
    final Iterator<String> iter = Arrays.asList(args).iterator();
    while (iter.hasNext()) {
        String token = iter.next();
        if (options.hasOption(token)) {
            filteredArgs.add(token);
            if (// PATH: Test should invoke the next Options.getOption(...) [step in execution path]
            options.getOption(token).hasArg() && iter.hasNext()) {
                filteredArgs.add(iter.next());
            }
        } else if (token.startsWith("-D")) {
            // "-Dkey=value"
            filteredArgs.add(token);
        }
    } 
    return filteredArgs.toArray(new String[0]);
}
