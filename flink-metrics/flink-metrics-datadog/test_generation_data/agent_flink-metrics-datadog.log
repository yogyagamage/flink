    @Test
    void testSendInvokesRequestBodyCreate() throws Exception {
        // Mock OkHttpClient to avoid real network calls
        OkHttpClient mockClient = Mockito.mock(OkHttpClient.class);
        OkHttpClient.Builder mockBuilder = Mockito.mock(OkHttpClient.Builder.class);
        
        // Setup builder to return our mock client
        when(mockBuilder.connectTimeout(any(), any())).thenReturn(mockBuilder);
        when(mockBuilder.writeTimeout(any(), any())).thenReturn(mockBuilder);
        when(mockBuilder.readTimeout(any(), any())).thenReturn(mockBuilder);
        when(mockBuilder.proxy(any())).thenReturn(mockBuilder);
        when(mockBuilder.build()).thenReturn(mockClient);
        
        // Create instance with minimal valid parameters
