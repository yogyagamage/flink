    client = new OkHttpClient.Builder().connectTimeout(TIMEOUT, TimeUnit.SECONDS).writeTimeout(TIMEOUT, TimeUnit.SECONDS).readTimeout(TIMEOUT, TimeUnit.SECONDS).proxy(proxy).build();
    seriesUrl = String.format(SERIES_URL_FORMAT, dataCenter.getDomain(), apiKey);
