            // Use reflection to set the private client field to our mock
            java.lang.reflect.Field clientField = DatadogHttpClient.class.getDeclaredField("client");
            clientField.setAccessible(true);
            clientField.set(instance, mockClient);
            
            return instance;
        } catch (Exception e) {
            throw new RuntimeException("Failed to create DatadogHttpClient with mocked OkHttpClient", e);
        }
    }
}

