        if (!response.isSuccessful()) {
            throw new IllegalArgumentException(String.format("API key: %s is invalid", apiKey));
        }
    } catch (IOException e) {
        throw new IllegalStateException("Failed contacting Datadog to validate API key", e);
    }
}
