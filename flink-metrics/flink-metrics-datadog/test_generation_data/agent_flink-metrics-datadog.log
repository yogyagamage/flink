    private DatadogHttpClient createDatadogHttpClientWithMockedOkHttpClient(OkHttpClient mockClient) {
        try {
            // Create instance using constructor
            DatadogHttpClient instance = new DatadogHttpClient(
                "test-api-key", 
                null, 
                0, 
                DataCenter.US, 
                false
