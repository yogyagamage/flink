            "test-api-key",
            null,
            0,
            DataCenter.US,
            false
        );
        
        // Use reflection to replace the internal client with our mock
        java.lang.reflect.Field clientField = DatadogHttpClient.class
            .getDeclaredField("client");
        clientField.setAccessible(true);
        clientField.set(client, mockClient);
        
        // Create a minimal DSeries object
        DSeries series = new DSeries();
        
        // This will invoke RequestBody.create() inside the send method
        client.send(series);
    }
}

