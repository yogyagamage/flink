import org.mockito.Mockito;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class DatadogHttpClientclose_ConnectionPoolevictAllFikaTest {

    @Test
    public void testCloseEvictAll() {
        // Create a mock ConnectionPool
        ConnectionPool mockConnectionPool = mock(ConnectionPool.class);
        
        // Create a mock Dispatcher with a mock ExecutorService
        OkHttpClient.Dispatcher mockDispatcher = mock(OkHttpClient.Dispatcher.class);
        when(mockDispatcher.executorService()).thenReturn(java.util.concurrent.Executors.newSingleThreadExecutor());
        
        // Create a mock OkHttpClient that returns our mocked dispatcher and connection pool
        OkHttpClient mockOkHttpClient = mock(OkHttpClient.class);
        when(mockOkHttpClient.dispatcher()).thenReturn(mockDispatcher);
        when(mockOkHttpClient.connectionPool()).thenReturn(mockConnectionPool);
        
