        case INTEGER :
            return "int";
        case BIGINT :
            return "long";
        case FLOAT :
            return "float";
        case DOUBLE :
            return "double";
        case BOOLEAN :
            return "boolean";
        case VARCHAR :
        case CHAR :
            return "StringData";
        case VARBINARY :
        case BINARY :
            return "byte[]";
        case ROW :
            return "RowData";
        case MAP :
            return "MapData";
        case ARRAY :
            return "ArrayData";
        default :
            throw new IllegalArgumentException("Unsupported data type in schema: " + type);
    }
}

