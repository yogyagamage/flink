    {
      "ruleId": "ssc-b60b786d-75c2-6082-6376-1c8ae9f06ab1",
      "title": "Allocation of Resources Without Limits or Throttling in com.fasterxml.jackson.core:jackson-core",
      "description": "Affected versions of com.fasterxml.jackson.core:jackson-core and tools.jackson.core:jackson-core are vulnerable to Allocation of Resources Without Limits or Throttling. Jackson Core's non-blocking (async) JSON parser bypasses `StreamReadConstraints.maxNumberLength`, allowing an attacker to submit JSON containing extremely long numeric literals that the async parser will accept and buffer without length validation. This can trigger excessive memory allocation in the parser's `TextBuffer` and potentially severe CPU exhaustion during numeric coercion (e.g., `BigInteger`/`BigDecimal` parsing), resulting in a Denial of Service in applications using the async parser APIs (such as reactive/WebFlux pipelines).",
      "ecosystem": "maven",
      "severity": "HIGH",
      "references": {
        "cweIds": [
          "CWE-770: Allocation of Resources Without Limits or Throttling"
        ],
