import org.apache.parquet.schema.Types;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.IOException;
import java.util.Collections;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyLong;

public class ParquetVectorizedInputFormatcheckSchema_ColumnDescriptorequalsFikaTest {

    @Test
    public void testCreateReaderInvokesColumnDescriptorEquals() throws IOException {
        // Create mock dependencies
        SerializableConfiguration hadoopConfig = Mockito.mock(SerializableConfiguration.class);
        RowType projectedType = Mockito.mock(RowType.class);
        ColumnBatchFactory<FileSourceSplit> batchFactory = Mockito.mock(ColumnBatchFactory.class);
        
        // Create real objects for constructor parameters
        LogicalType[] logicalTypes = new LogicalType[0];
        String[] fieldNames = new String[0];
        
        Mockito.when(projectedType.getFieldNames()).thenReturn(Collections.emptyList());
        Mockito.when(projectedType.getChildren()).thenReturn(Collections.emptyList());
        
        // Create the format instance
        ParquetVectorizedInputFormat<FileSourceSplit> format = 
            new ParquetVectorizedInputFormat<>(
                hadoopConfig,
                projectedType,
                batchFactory,
                100,
                false,
                false
            );
        
        // Create mock FileSourceSplit
        FileSourceSplit split = Mockito.mock(FileSourceSplit.class);
        Path mockPath = Mockito.mock(Path.class);
        FileSystem mockFs = Mockito.mock(FileSystem.class);
        FileSystem.DataInputStream mockStream = Mockito.mock(FileSystem.DataInputStream.class);
        
        Mockito.when(split.path()).thenReturn(mockPath);
        Mockito.when(split.offset()).thenReturn(0L);
        Mockito.when(split.length()).thenReturn(100L);
        Mockito.when(mockPath.getFileSystem()).thenReturn(mockFs);
        Mockito.when(mockFs.open(any(Path.class))).thenReturn(mockStream);
        Mockito.when(mockFs.getFileStatus(any(Path.class))).thenReturn(
            new FileSystem.FileStatus() {
                public long getLen() { return 100L; }
                public long getBlockSize() { return 100L; }
                public long getAccessTime() { return 0L; }
                public long getModificationTime() { return 0L; }
                public short getReplication() { return 1; }
                public Path getPath() { return mockPath; }
                public boolean isDir() { return false; }
            }
        );
        
        // Create mock ParquetFileReader with proper schema
        ParquetFileReader mockReader = Mockito.mock(ParquetFileReader.class);
        org.apache.parquet.hadoop.metadata.ParquetMetadata mockFooter = 
            Mockito.mock(org.apache.parquet.hadoop.metadata.ParquetMetadata.class);
        org.apache.parquet.hadoop.metadata.FileMetaData mockFileMetaData = 
            Mockito.mock(org.apache.parquet.hadoop.metadata.FileMetaData.class);
        
        // Create real MessageType with ColumnDescriptor that will trigger equals call
        MessageType fileSchema = Types.buildMessage()
            .requiredGroup()
                .required(PrimitiveType.PrimitiveTypeName.INT32).named("id")
            .named("schema");
        
        MessageType requestedSchema = Types.buildMessage()
            .requiredGroup()
                .required(PrimitiveType.PrimitiveTypeName.INT32).named("id")
            .named("schema");
        
        Mockito.when(mockReader.getFooter()).thenReturn(mockFooter);
        Mockito.when(mockFooter.getFileMetaData()).thenReturn(mockFileMetaData);
        Mockito.when(mockFileMetaData.getSchema()).thenReturn(fileSchema);
        Mockito.when(mockReader.getRecordCount()).thenReturn(10L);
        
        // Mock static method call using Mockito's mock static capability
        try (var mocked = Mockito.mockStatic(ParquetFileReader.class)) {
            mocked.when(() -> ParquetFileReader.open(any(), any()))
                  .thenReturn(mockReader);
            
            // Mock the clipParquetSchema method to return requestedSchema
            // This ensures checkSchema gets called with matching schemas
            format = Mockito.spy(format);
            Mockito.doReturn(requestedSchema)
                   .when(format)
                   .clipParquetSchema(any(MessageType.class), any(), any());
            
            // Mock pool creation to avoid NPE
            Mockito.doReturn(Mockito.mock(Pool.class))
                   .when(format)
                   .createPoolOfBatches(any(), any(), anyInt());
            
            // Create configuration
            Configuration config = new Configuration();
            
            // This should trigger the call chain:
            // createReader -> checkSchema -> ColumnDescriptor.equals
            format.createReader(config, split);
        }
    }
}

