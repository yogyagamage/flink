package org.apache.flink.formats.parquet.vector.reader;

import org.apache.flink.table.data.columnar.vector.writable.WritableColumnVector;
import org.apache.flink.table.types.logical.LogicalType;
import org.apache.flink.table.types.logical.LogicalTypeRoot;
import org.apache.parquet.column.ColumnDescriptor;
import org.apache.parquet.column.page.PageReader;
import org.apache.parquet.schema.PrimitiveType;
import org.apache.parquet.schema.Type;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyInt;
import static org.mockito.Mockito.when;

class NestedPrimitiveColumnReader_2method_PrimitiveTypeNameordinalFikaTest {

    @Test
    void testReadAndNewVector() throws IOException {
        // Create mocks for constructor dependencies
        ColumnDescriptor mockDescriptor = Mockito.mock(ColumnDescriptor.class);
        PageReader mockPageReader = Mockito.mock(PageReader.class);
        Type mockParquetType = Mockito.mock(Type.class);
        PrimitiveType mockPrimitiveType = Mockito.mock(PrimitiveType.class);
        LogicalType mockLogicalType = Mockito.mock(LogicalType.class);
        
        // Setup the mock descriptor to return a primitive type
        when(mockDescriptor.getPrimitiveType()).thenReturn(mockPrimitiveType);
        
        // Setup the mock primitive type to return a PrimitiveTypeName
        // This will trigger the ordinal() call in fillColumnVector
        when(mockPrimitiveType.getPrimitiveTypeName()).thenReturn(PrimitiveType.PrimitiveTypeName.INT32);
        
        // Setup the mock parquet type to return the primitive type
        when(mockParquetType.asPrimitiveType()).thenReturn(mockPrimitiveType);
        
        // Setup the mock logical type to return DECIMAL type root
        // This ensures we go into the DECIMAL case in fillColumnVector
        when(mockLogicalType.getTypeRoot()).thenReturn(LogicalTypeRoot.DECIMAL);
        
        // Create the instance using the constructor
        NestedPrimitiveColumnReader reader = new NestedPrimitiveColumnReader(
            mockDescriptor,
            mockPageReader,
            false,
            mockParquetType,
            mockLogicalType
        );
        
        // Create a mock vector
        WritableColumnVector mockVector = Mockito.mock(WritableColumnVector.class);
        
        // Call the entry point method
        // The readNumber should be >0 to enter the while loop
        reader.readAndNewVector(1, mockVector);
    }
}

