    private void createMinimalParquetFile(File file) throws IOException {
        // Create a minimal Parquet file with proper magic numbers and footer
        // This is a simplified version that creates a file ParquetFileReader can parse
        byte[] magic = "PAR1".getBytes();
        byte[] footer = new byte[0]; // Empty footer for minimal file
        
        try (FileOutputStream fos = new FileOutputStream(file)) {
            // Write magic number at start
            fos.write(magic);
            
            // Write some dummy data (in real parquet this would be row groups)
            fos.write(new byte[100]);
            
            // Write footer length (0) and magic number at end
            fos.write(new byte[4]); // Footer length = 0
            fos.write(magic);
        }
        
        // Note: This creates a technically invalid but parseable Parquet file
        // The actual content doesn't matter as long as ParquetFileReader can read the footer
    }
