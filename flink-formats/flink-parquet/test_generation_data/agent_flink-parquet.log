        if (leftInPage == 0) {
            DataPage page = pageReader.readPage();
            if (page instanceof DataPageV1) {
                readPageV1(((DataPageV1) (page)));
            } else if (page instanceof DataPageV2) {
                readPageV2(((DataPageV2) (page)));
            } else {
