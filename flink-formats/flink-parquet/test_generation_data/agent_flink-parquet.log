                new MessageType("root", new ArrayList<Type>()),
                new java.util.HashMap<String, String>(),
                "test"
            );
            
            ParquetMetadata metadata = new ParquetMetadata(
                fileMetaData,
                new ArrayList<BlockMetaData>()
            );
            
            return metadata;
        }
        
        // Intercept clipParquetSchema to return a schema that will trigger getMaxDefinitionLevel()
