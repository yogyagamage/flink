    private byte[] createMinimalParquetFile() {
        // Create a minimal valid Parquet file with proper footer
        // PAR1 magic (4 bytes) + minimal metadata + PAR1 magic (4 bytes)
        byte[] magic = "PAR1".getBytes();
        byte[] file = new byte[magic.length * 2 + 4];
        
        // First magic
        System.arraycopy(magic, 0, file, 0, magic.length);
        
        // Footer metadata (4 bytes: file metadata length = 0)
        file[magic.length] = 0;
        file[magic.length + 1] = 0;
        file[magic.length + 2] = 0;
        file[magic.length + 3] = 0;
        
        // End magic
        System.arraycopy(magic, 0, file, magic.length + 4, magic.length);
        
        return file;
    }
}

