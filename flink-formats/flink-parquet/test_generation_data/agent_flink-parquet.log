import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class ParquetColumnarRowSplitReadermethod_ParquetFileReadermethodFikaTest {

    @TempDir
    File tempDir;

    @Test
    public void testConstructorCallsParquetFileReaderConstructor() throws IOException {
        // Create a minimal valid Parquet file
        File parquetFile = new File(tempDir, "test.parquet");
        Files.write(parquetFile.toPath(), createMinimalParquetFile());
        
        boolean utcTimestamp = false;
        boolean caseSensitive = true;
        Configuration conf = new Configuration();
        LogicalType[] selectedTypes = new LogicalType[0];
        String[] selectedFieldNames = new String[0];
        
        // Mock the ColumnBatchGenerator
        ColumnBatchGenerator generator = mock(ColumnBatchGenerator.class);
        VectorizedColumnBatch mockBatch = mock(VectorizedColumnBatch.class);
        when(generator.generate(any(WritableColumnVector[].class))).thenReturn(mockBatch);
        
        int batchSize = 100;
        Path path = new Path(parquetFile.toURI());
        long splitStart = 0;
        long splitLength = parquetFile.length();
        
        // Instantiate the class under test
        // This will trigger the constructor chain and eventually call ParquetFileReader constructor
        new ParquetColumnarRowSplitReader(
            utcTimestamp,
            caseSensitive,
            conf,
            selectedTypes,
            selectedFieldNames,
            generator,
            batchSize,
            path,
            splitStart,
            splitLength
        );
    }

    private byte[] createMinimalParquetFile() {
        // Create a minimal valid Parquet file with proper footer
        // PAR1 magic number (4 bytes) + minimal metadata + footer length + PAR1 magic number
        byte[] magic = "PAR1".getBytes();
        byte[] metadata = new byte[] {
            // Simple metadata with minimal schema
            0x15, 0x00, 0x15, 0x00, 0x15, 0x00, 0x15, 0x00, 0x00, 0x00,
            0x15, 0x00, 0x15, 0x00, 0x15, 0x00, 0x15, 0x00, 0x00, 0x00
        };
        
        // Footer length (4 bytes, little endian)
        int footerLength = metadata.length + 4; // metadata + magic
        byte[] footerLenBytes = new byte[] {
            (byte) (footerLength & 0xFF),
            (byte) ((footerLength >> 8) & 0xFF),
            (byte) ((footerLength >> 16) & 0xFF),
            (byte) ((footerLength >> 24) & 0xFF)
        };
        
        // Combine everything
        byte[] result = new byte[magic.length + metadata.length + footerLenBytes.length + magic.length];
        System.arraycopy(magic, 0, result, 0, magic.length);
        System.arraycopy(metadata, 0, result, magic.length, metadata.length);
        System.arraycopy(footerLenBytes, 0, result, magic.length + metadata.length, footerLenBytes.length);
        System.arraycopy(magic, 0, result, magic.length + metadata.length + footerLenBytes.length, magic.length);
        
        return result;
    }
}

