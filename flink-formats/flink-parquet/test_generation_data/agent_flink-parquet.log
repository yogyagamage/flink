            fos.write(footerLength & 0xFF);
            fos.write((footerLength >> 8) & 0xFF);
            fos.write((footerLength >> 16) & 0xFF);
            fos.write((footerLength >> 24) & 0xFF);
            
            // Write PAR1 magic bytes at end
            fos.write('P');
            fos.write('A');
            fos.write('R');
            fos.write('1');
        }
        
