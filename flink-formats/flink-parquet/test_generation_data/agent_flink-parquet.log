    private byte[] createMinimalParquetFile() {
        // Create a minimal valid Parquet file with proper footer
        // PAR1 magic number (4 bytes) + empty data + footer metadata + footer length
        byte[] magic = "PAR1".getBytes();
        byte[] footer = new byte[] {
            // Simple footer structure for a minimal valid file
            0x15, 0x00, 0x15, 0x00, 0x15, 0x00, 0x15, 0x00, 0x00, 0x00,
            0x15, 0x00, 0x15, 0x00, 0x15, 0x00, 0x15, 0x00, 0x00, 0x00
        };
        
        byte[] result = new byte[magic.length + footer.length + 4 + magic.length];
        System.arraycopy(magic, 0, result, 0, magic.length);
        System.arraycopy(footer, 0, result, magic.length, footer.length);
        
        // Write footer length (4 bytes, little endian)
        int footerLength = footer.length;
        result[magic.length + footer.length] = (byte) (footerLength & 0xFF);
        result[magic.length + footer.length + 1] = (byte) ((footerLength >> 8) & 0xFF);
        result[magic.length + footer.length + 2] = (byte) ((footerLength >> 16) & 0xFF);
        result[magic.length + footer.length + 3] = (byte) ((footerLength >> 24) & 0xFF);
        
        // Write ending magic
        System.arraycopy(magic, 0, result, magic.length + footer.length + 4, magic.length);
        
        return result;
    }
}

