                new org.apache.parquet.schema.PrimitiveType(
                    org.apache.parquet.schema.Type.Repetition.REQUIRED,
                    org.apache.parquet.schema.PrimitiveType.PrimitiveTypeName.INT64,
                    "missing_column"
                );
            types.add(primitiveType);
            
            // Create the MessageType with our column
            MessageType requestedSchema = new MessageType("requested", types);
            
            // Use reflection to set the columns list
            try {
                java.lang.reflect.Field columnsField = MessageType.class.getDeclaredField("columns");
                columnsField.setAccessible(true);
                columnsField.set(requestedSchema, columns);
                
                // Also set paths
                java.lang.reflect.Field pathsField = MessageType.class.getDeclaredField("paths");
                pathsField.setAccessible(true);
