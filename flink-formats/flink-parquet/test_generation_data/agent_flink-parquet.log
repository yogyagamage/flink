    File tempDir;

    @Test
    public void testConstructorCallsParquetFileReaderConstructor() throws IOException {
        // Create a minimal valid Parquet file
        File parquetFile = new File(tempDir, UUID.randomUUID() + ".parquet");
        try (FileOutputStream fos = new FileOutputStream(parquetFile)) {
            // Write Parquet magic bytes
            fos.write("PAR1".getBytes());
            // Write some dummy data to make file non-empty
            fos.write(new byte[100]);
            // Write end magic
            fos.write("PAR1".getBytes());
        }

