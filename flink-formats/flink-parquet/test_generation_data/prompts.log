public ParquetRowDataWriter(RecordConsumer recordConsumer, RowType rowType, GroupType schema, boolean utcTimestamp, Configuration conf) {
    this.recordConsumer = recordConsumer;
    this.utcTimestamp = utcTimestamp;
    this.conf = conf;
    if (this.conf != null) {
        useInt64 = this.conf.getBoolean((IDENTIFIER + ".") + WRITE_INT64_TIMESTAMP.key(), WRITE_INT64_TIMESTAMP.defaultValue());
