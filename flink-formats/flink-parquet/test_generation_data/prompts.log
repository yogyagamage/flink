        long mills = timestampData.getMillisecond();
        julianDay = ((int) ((mills / MILLIS_IN_DAY) + JULIAN_EPOCH_OFFSET_DAYS));
        nanosOfDay = ((mills % MILLIS_IN_DAY) * NANOS_PER_MILLISECOND) + timestampData.getNanoOfMillisecond();
