    for (int i = rowId; i < (rowId + num); ++i) {
        if (!column.isNullAt(i)) {
            byte[] bytes = dictionary.decodeToBinary(dictionaryIds.getInt(i)).getBytesUnsafe();
            column.appendBytes(i, bytes, 0, bytes.length);
        }
    }
}
