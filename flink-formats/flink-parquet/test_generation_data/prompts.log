            return ConversionPatterns.mapType(repetition, name, MAP_REPEATED_NAME, convertToParquetType("key", elementType, conf), convertToParquetType("value", new IntType(false), conf));
        case ROW :
            RowType rowType = ((RowType) (type));
            return new GroupType(repetition, name, convertToParquetTypes(rowType, conf));
        default :
            throw new UnsupportedOperationException("Unsupported type: " + type);
    }
}
