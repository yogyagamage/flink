            timeUnit = LogicalTypeAnnotation.TimeUnit.valueOf(this.conf.get((IDENTIFIER + ".") + TIMESTAMP_TIME_UNIT.key(), TIMESTAMP_TIME_UNIT.defaultValue()).toUpperCase());
        }
    }
    rowWriter = new RowWriter(rowType, schema);
}

