public NestedPrimitiveColumnReader(ColumnDescriptor descriptor, PageReader pageReader, boolean isUtcTimestamp, Type parquetType, LogicalType logicalType) throws IOException {
    this.descriptor = descriptor;
    this.type = parquetType;
    this.pageReader = pageReader;
    this.maxDefLevel = descriptor.getMaxDefinitionLevel();
    this.isUtcTimestamp = isUtcTimestamp;
