        return new TableStats(rowCount, columnStatsMap);
    } catch (Exception e) {
        LOG.warn("Reporting statistics failed for Parquet format", e);
        return TableStats.UNKNOWN;
    } finally {
        if (executorService != null) {
            executorService.shutdownNow();
        }
    }
}

