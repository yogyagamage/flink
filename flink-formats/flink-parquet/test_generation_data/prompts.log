        nanosOfDay = (((mills % MILLIS_IN_DAY) / 1000) * NANOS_PER_SECOND) + timestamp.getNanos();
    }
    ByteBuffer buf = ByteBuffer.allocate(12);
    buf.order(ByteOrder.LITTLE_ENDIAN);
    buf.putLong(nanosOfDay);
    buf.putInt(julianDay);
