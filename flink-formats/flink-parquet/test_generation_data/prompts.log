            ArrayType arrayType = ((ArrayType) (type));
            return ConversionPatterns.listOfElements(repetition, name, convertToParquetType(LIST_ELEMENT_NAME, arrayType.getElementType(), conf));
        case MAP :
            MapType mapType = ((MapType) (type));
            LogicalType keyType = mapType.getKeyType();
            if (keyType.isNullable()) {
