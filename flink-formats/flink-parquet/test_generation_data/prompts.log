protected void readBatchFromDictionaryIds(int rowId, int num, WritableIntVector column, WritableIntVector dictionaryIds) {
    for (int i = rowId; i < (rowId + num); ++i) {
        if (!column.isNullAt(i)) {
            column.setInt(i, dictionary.decodeToInt(dictionaryIds.getInt(i)));
        }
    }
}

