            } else if (addBlockPadding) {
                // if we cross the block boundary, figure out what we should do
                long padding = blockSize - previousBytesInBlock;
                if (padding <= maxPadding) {
                    writeZeros(out, padding);
                    stripeStart += padding;
                }
