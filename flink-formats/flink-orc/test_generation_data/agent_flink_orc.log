public PhysicalWriterImpl(FSDataOutputStream out, OrcFile.WriterOptions opts) throws IOException {
    if (opts.isEnforceBufferSize()) {
        this.bufferSize = opts.getBufferSize();
    } else {
        this.bufferSize = getEstimatedBufferSize(opts.getStripeSize(), opts.getSchema().getMaximumId() + 1, opts.getBufferSize());
