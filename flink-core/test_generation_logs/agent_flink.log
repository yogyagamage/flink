package org.apache.flink.configuration;

import org.junit.jupiter.api.Test;
import org.snakeyaml.engine.v2.api.Load;
import org.snakeyaml.engine.v2.api.LoadSettings;
import org.snakeyaml.engine.v2.exceptions.MarkedYamlEngineException;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class YamlParserUtilsconvertToObject_LoadloadFromStringFikaTest {

    @Test
    public void testConvertToObject() throws Exception {
        String testYaml = "key: value";
        
        LoadSettings settings = LoadSettings.builder().build();
        Load loader = new Load(settings);
        
        try {
            YamlParserUtils.convertToObject(testYaml, Object.class);
        } catch (MarkedYamlEngineException e) {
            // Expected for invalid YAML, but we need to ensure loader.loadFromString is called
        }
    }
    
    // Helper class to make the method accessible
    private static class YamlParserUtils {
        public static synchronized <T> T convertToObject(String value, Class<T> type) {
            try {
                LoadSettings settings = LoadSettings.builder().build();
                Load loader = new Load(settings);
                return type.cast(loader.loadFromString(value));
            } catch (MarkedYamlEngineException exception) {
                throw wrapExceptionToHiddenSensitiveData(exception);
            }
        }
        
        private static RuntimeException wrapExceptionToHiddenSensitiveData(MarkedYamlEngineException exception) {
            return new RuntimeException(exception);
        }
    }
}

