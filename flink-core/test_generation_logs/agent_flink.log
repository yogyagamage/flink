        TarArchiveEntry entry;
        while (// PATH: Test should invoke the next new TarArchiveInputStream(...) [step in execution path]
        (entry = tai.getNextTarEntry()) != null) {
            unpackEntry(tai, entry, targetDir);
        } 
    }
}

