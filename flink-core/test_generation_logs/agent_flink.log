    private static byte[] createMinimalTarContent(String filename) {
        // Create minimal tar header for an empty file
        byte[] header = new byte[512];
        
        // File name (100 bytes)
        byte[] nameBytes = filename.getBytes(java.nio.charset.StandardCharsets.UTF_8);
        System.arraycopy(nameBytes, 0, header, 0, Math.min(nameBytes.length, 100));
        
        // File mode (8 bytes)
        String mode = "0000644\0";
        System.arraycopy(mode.getBytes(), 0, header, 100, 8);
        
        // Owner and group IDs (16 bytes total)
        String uid = "0001750\0";
        String gid = "0001750\0";
        System.arraycopy(uid.getBytes(), 0, header, 108, 8);
        System.arraycopy(gid.getBytes(), 0, header, 116, 8);
        
        // File size (12 bytes) - empty file
        String size = "00000000000\0";
        System.arraycopy(size.getBytes(), 0, header, 124, 12);
        
        // Modification time (12 bytes)
        String mtime = "00000000000\0";
        System.arraycopy(mtime.getBytes(), 0, header, 136, 12);
        
        // Type flag (1 byte) - regular file
        header[156] = '0';
        
        // Magic (6 bytes)
        String magic = "ustar\0";
        System.arraycopy(magic.getBytes(), 0, header, 257, 6);
        
        // Version (2 bytes)
        header[263] = '0';
        header[264] = '0';
        
        // Calculate checksum
        int checksum = 0;
        for (int i = 0; i < 512; i++) {
            checksum += header[i] & 0xFF;
        }
        
        // Write checksum (8 bytes)
        String checksumStr = String.format("%06o\0 ", checksum);
        System.arraycopy(checksumStr.getBytes(), 0, header, 148, 8);
        
        // Create complete tar block (header + empty content + padding)
        byte[] tarContent = new byte[1024];
        System.arraycopy(header, 0, tarContent, 0, 512);
        // Rest is zeros (padding)
        
        return tarContent;
    }
    
