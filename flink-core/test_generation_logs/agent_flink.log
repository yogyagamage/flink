package org.apache.flink.api.java.typeutils.runtime.kryo;

import org.apache.flink.api.common.ExecutionConfig;
import org.apache.flink.api.common.typeinfo.TypeInformation;
import org.apache.flink.api.common.typeutils.TypeSerializer;
import org.apache.flink.api.java.typeutils.GenericTypeInfo;
import com.esotericsoftware.kryo.KryoException;
import org.junit.jupiter.api.Test;
import java.io.Serializable;
import java.util.ArrayList;

public class KryoSerializercopy_KryoreadObjectFikaTest {

    @Test
    public void testCopyInvokesKryoReadObject() throws Exception {
        // Create a simple serializable object that will trigger KryoException during copy
        SerializableObject obj = new SerializableObject();
        obj.data = "test";
        
        // Create TypeInformation for the object
        TypeInformation<SerializableObject> typeInfo = new GenericTypeInfo<>(SerializableObject.class);
        
        // Create ExecutionConfig with Kryo configuration that will cause copy to fail
        ExecutionConfig config = new ExecutionConfig();
        config.enableForceKryo();
        
        // Create the serializer - this is the class under test
        TypeSerializer<SerializableObject> serializer = typeInfo.createSerializer(config);
        
        // The test object needs to be wrapped in a special way to trigger the exception path
        // We'll create a custom object that will throw KryoException when kryo.copy() is called
        ProblematicObject problematicObj = new ProblematicObject();
        
        // Create a new serializer specifically for ProblematicObject
        TypeInformation<ProblematicObject> problematicTypeInfo = new GenericTypeInfo<>(ProblematicObject.class);
        TypeSerializer<ProblematicObject> problematicSerializer = problematicTypeInfo.createSerializer(config);
        
        // This should trigger the exception path in copy() which will then call kryo.readObject()
        try {
            problematicSerializer.copy(problematicObj);
        } catch (Exception e) {
            // Expected - we don't care about the exception
        }
    }
    
    // A simple serializable class
    public static class SerializableObject implements Serializable {
        private static final long serialVersionUID = 1L;
        public String data;
    }
    
    // A class that will cause KryoException when kryo.copy() is called
    public static class ProblematicObject implements Serializable {
        private static final long serialVersionUID = 2L;
        
        // This will cause issues during copy
        private Object selfReference;
        
        public ProblematicObject() {
            // Create a circular reference that will cause problems during copy
            ArrayList<Object> list = new ArrayList<>();
            list.add(this);
            selfReference = list;
        }
    }
}

