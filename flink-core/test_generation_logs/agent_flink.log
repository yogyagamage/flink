private static final DumpSettings flowDumperSettings = // Disable split long lines to avoid add unexpected line breaks
DumpSettings.builder().setDefaultFlowStyle(FlowStyle.FLOW).setSplitLines(false).setSchema(new CoreSchema()).build();
private static final Dump blockerDumper = new Dump(blockerDumperSettings, new FlinkConfigRepresenter(blockerDumperSettings));
