import com.esotericsoftware.kryo.io.Input;
import com.esotericsoftware.kryo.io.Output;
import org.junit.jupiter.api.Test;

import java.io.ByteArrayInputStream;
import java.io.ByteArrayOutputStream;

import static org.mockito.Mockito.*;

public class KryoSerializercopy_KryoreadObjectFikaTest {

    @Test
    public void testCopyInvokesKryoReadObject() throws Exception {
        // Create a real Kryo instance
        Kryo kryo = new Kryo();
        
        // Create a test object that will trigger KryoException during copy
        TestObject original = new TestObject("test-data");
        
        // Configure kryo to throw exception on copy to trigger the fallback path
        Kryo spyKryo = spy(kryo);
        when(spyKryo.copy(original)).thenThrow(new KryoException("Forced exception for test"));
        
        // Create the serializer instance
        KryoSerializer<TestObject> serializer = new KryoSerializer<>(
                TestObject.class, 
                new org.apache.flink.api.java.ExecutionConfig()
        );
        
        // Use reflection to inject our spy kryo instance
        java.lang.reflect.Field kryoField = KryoSerializer.class.getDeclaredField("kryo");
        kryoField.setAccessible(true);
        kryoField.set(serializer, spyKryo);
        
        // Disable concurrent access check to simplify test
        java.lang.reflect.Field concurrentField = KryoSerializer.class.getDeclaredField("CONCURRENT_ACCESS_CHECK");
        concurrentField.setAccessible(true);
        concurrentField.set(serializer, false);
        
        // This should trigger the fallback path that calls kryo.readObject()
        serializer.copy(original);
    }
    
    // Simple test class that will be serialized
    public static class TestObject {
        private String data;
        
        public TestObject(String data) {
            this.data = data;
        }
        
        public String getData() {
            return data;
        }
        
        public void setData(String data) {
            this.data = data;
        }
    }
}

