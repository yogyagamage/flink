@Override
@PublicEvolving
public TypeSerializer<T> createSerializer(SerializerConfig config) {
    if (config.hasGenericTypesDisabled()) {
        throw new UnsupportedOperationException(("Generic types have been disabled in the ExecutionConfig and type " + this.typeClass.getName()) + " is treated as a generic type.");
    }
    return new KryoSerializer<T>(this.typeClass, config);
}

