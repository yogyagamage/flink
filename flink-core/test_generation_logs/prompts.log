private static String getGenericTypeTree(Class<?> type, int indent) {
    String ret = "";
    for (Field field : type.getDeclaredFields()) {
        if (Modifier.isStatic(field.getModifiers()) || Modifier.isTransient(field.getModifiers())) {
            continue;
        }
        // PATH: Test should invoke the next StringUtils.repeat(...) [step in execution path]
        ret += ((((StringUtils.repeat(' ', indent) + field.getName()) + ":") + field.getType().getName()) + (field.getType().isEnum() ? " (is enum)" : "")) + "
";
        if (!field.getType().isPrimitive()) {
            ret += Utils.getGenericTypeTree(field.getType(), indent + 4);
        }
    }
    return ret;
}

