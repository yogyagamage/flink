// --------------------------------------------------------------------------------------------
@Override
public Map<String, String> toMap() {
    synchronized(this.confData) {
        Map<String, String> ret = CollectionUtil.newHashMapWithExpectedSize(this.confData.size());
        for (Map.Entry<String, Object> entry : confData.entrySet()) {
            // PATH: Test should invoke the next ConfigurationUtils.convertToString(...) [step in execution path]
            ret.put(entry.getKey(), ConfigurationUtils.convertToString(entry.getValue()));
        }
        return ret;
    }
}

static String convertToString(Object o) {
    if (o.getClass() == String.class) {
        return ((String) (o));
    } else {
        return YamlParserUtils.toYAMLString(o);
    }
}

