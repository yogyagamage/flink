    try {
        checkKryoInitialized();
        if (this.copyInstance == null) {
            this.copyInstance = createInstance();
        }
        T tmp = deserialize(copyInstance, source);
        serialize(tmp, target);
    } finally {
        if (CONCURRENT_ACCESS_CHECK) {
            exitExclusiveThread();
        }
    }
}

