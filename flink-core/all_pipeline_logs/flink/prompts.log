            leftReturn = ((IN1) (currLeftIterator.next()));
            if (outerJoinType != OuterJoinType.RIGHT) {
                currRightIterator = new ListIteratorWrapper(currRightSubset.iterator());
            }
            rightReturn = ((IN2) (currRightIterator.next()));
