        private final int[] fieldPositions;
        private final boolean[] sortDirections;

        public Ordering(int field, boolean ascending, Ordering... additional) {
            List<Integer> positions = new ArrayList<>();
            List<Boolean> directions = new ArrayList<>();
            
            positions.add(field);
            directions.add(ascending);
            
            for (Ordering o : additional) {
                for (int pos : o.getFieldPositions()) {
                    positions.add(pos);
                }
                for (boolean dir : o.getFieldSortDirections()) {
                    directions.add(dir);
                }
            }
            
            this.fieldPositions = positions.stream().mapToInt(i -> i).toArray();
            this.sortDirections = new boolean[directions.size()];
            for (int i = 0; i < directions.size(); i++) {
                sortDirections[i] = directions.get(i);
            }
        }

        @Override
        public int[] getFieldPositions() {
            return fieldPositions;
        }

        @Override
        public boolean[] getFieldSortDirections() {
            return sortDirections;
        }
    }
