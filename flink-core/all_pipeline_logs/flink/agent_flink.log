class ConfigurationUtils_YamlParserUtilsmethod_DumpmethodFikaTest4 {

    @Test
    void testParseStringToMapTriggersDumpConstructor() {
        // The static initializer of YamlParserUtils will be triggered when we call
        // parseStringToMap with a YAML-formatted string that causes the convertToProperties
        // method to go into the else branch and call YamlParserUtils.convertToObject.
        // This will load the YamlParserUtils class, triggering its static initializer
        // which creates Dump instances, thus calling the target third-party constructor.
        
        // YAML format that will be parsed by YamlParserUtils.convertToObject
        String yamlMapString = "{key1: value1, key2: value2}";
        
        // This call will trigger:
        // 1. ConfigurationUtils.parseStringToMap(yamlMapString)
        // 2. ConfigurationUtils.convertToProperties(yamlMapString) 
