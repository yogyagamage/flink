    @Test
    public void testExtractTarFileTriggersGzipCompressorInputStream(@TempDir Path tempDir) throws IOException {
        // Create a gzipped tar file to ensure the gzip path is taken
        File tarFile = new File(tempDir.toFile(), "test.tar.gz");
