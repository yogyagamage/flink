    private void createTarWithSymbolicLink(Path tarFilePath) throws IOException {
        try (OutputStream fo = Files.newOutputStream(tarFilePath);
             TarArchiveOutputStream tos = new TarArchiveOutputStream(fo)) {
            
            // Create a regular file entry
            TarArchiveEntry fileEntry = new TarArchiveEntry("regular.txt");
            fileEntry.setSize(5);
            tos.putArchiveEntry(fileEntry);
            tos.write("test".getBytes());
            tos.closeArchiveEntry();

            // Create a symbolic link entry
            TarArchiveEntry symlinkEntry = new TarArchiveEntry("link.txt", TarArchiveEntry.LF_SYMLINK);
            symlinkEntry.setLinkName("regular.txt");
            tos.putArchiveEntry(symlinkEntry);
            tos.closeArchiveEntry();
        }
    }
}

