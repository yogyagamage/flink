package org.apache.flink.util;

import org.apache.commons.compress.archivers.tar.TarArchiveEntry;
import org.apache.commons.compress.archivers.tar.TarArchiveInputStream;
import org.apache.commons.compress.compressors.gzip.GzipCompressorInputStream;
import org.junit.jupiter.api.Test;
import org.slf4j.Logger;

import java.io.BufferedInputStream;
import java.io.File;
import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.nio.file.Files;
import java.nio.file.Paths;

public class CompressionUtilsunpackEntry_TarArchiveEntrygetDirectoryEntriesFikaTest {

    @Test
    public void testExtractTarFile() throws IOException {
        CompressionUtils compressionUtils = new CompressionUtils();
        
        File tempDir = Files.createTempDirectory("flink-test").toFile();
        File tempTarFile = new File(tempDir, "test.tar");
        
        try {
            createTarFileWithDirectoryEntry(tempTarFile);
            compressionUtils.extractTarFile(tempTarFile.getAbsolutePath(), tempDir.getAbsolutePath());
        } finally {
            tempTarFile.delete();
            deleteDirectory(tempDir);
        }
    }
    
    private void createTarFileWithDirectoryEntry(File tarFile) throws IOException {
        try (TarArchiveOutputStream tarOut = new TarArchiveOutputStream(Files.newOutputStream(tarFile.toPath()))) {
            TarArchiveEntry dirEntry = new TarArchiveEntry("testdir/");
            tarOut.putArchiveEntry(dirEntry);
            tarOut.closeArchiveEntry();
        }
    }
    
    private void deleteDirectory(File dir) {
        if (dir.exists()) {
            File[] files = dir.listFiles();
            if (files != null) {
                for (File file : files) {
                    if (file.isDirectory()) {
                        deleteDirectory(file);
                    } else {
                        file.delete();
                    }
                }
            }
            dir.delete();
        }
    }
    
    private static class TarArchiveOutputStream extends org.apache.commons.compress.archivers.tar.TarArchiveOutputStream {
        public TarArchiveOutputStream(OutputStream out) {
            super(out);
        }
    }
}

