    @Test
    public void testRestoreSerializerTriggersConfigureKryoLogging() throws Exception {
        // Create snapshot data with minimal configuration
        Class<String> typeClass = String.class;
        LinkedHashMap<Class<?>, SerializableSerializer<?>> defaultKryoSerializers = 
            new LinkedHashMap<>();
        LinkedHashMap<Class<?>, Class<? extends Serializer<?>>> defaultKryoSerializerClasses = 
