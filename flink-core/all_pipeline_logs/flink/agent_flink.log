        // Set up static logging to enable TRACE level
        Logger logger = Mockito.mock(Logger.class);
        Mockito.when(logger.isTraceEnabled()).thenReturn(true);
        
        // Replace the static LOG field in KryoSerializer with our mock
        Field logField = KryoSerializer.class.getDeclaredField("LOG");
        logField.setAccessible(true);
        Logger originalLogger = (Logger) logField.get(null);
        
        try {
            logField.set(null, logger);
            
            // Create instance using the public constructor
            Class<String> type = String.class;
            SerializerConfig serializerConfig = Mockito.mock(SerializerConfigImpl.class);
            
            LinkedHashMap<Class<?>, SerializableSerializer<?>> defaultSerializers = new LinkedHashMap<>();
            LinkedHashMap<Class<?>, Class<? extends Serializer<?>>> defaultSerializerClasses = new LinkedHashMap<>();
            LinkedHashSet<Class<?>> registeredTypes = new LinkedHashSet<>();
            LinkedHashMap<Class<?>, Class<? extends Serializer<?>>> registeredTypesWithSerializerClasses = new LinkedHashMap<>();
            LinkedHashMap<Class<?>, SerializableSerializer<?>> registeredTypesWithSerializers = new LinkedHashMap<>();
            
            Mockito.when(((SerializerConfigImpl) serializerConfig).getDefaultKryoSerializers())
                   .thenReturn(defaultSerializers);
            Mockito.when(serializerConfig.getDefaultKryoSerializerClasses())
                   .thenReturn(defaultSerializerClasses);
            Mockito.when(serializerConfig.getRegisteredKryoTypes())
                   .thenReturn(registeredTypes);
            Mockito.when(serializerConfig.getRegisteredTypesWithKryoSerializerClasses())
                   .thenReturn(registeredTypesWithSerializerClasses);
            Mockito.when(((SerializerConfigImpl) serializerConfig).getRegisteredTypesWithKryoSerializers())
                   .thenReturn(registeredTypesWithSerializers);
            Mockito.when(serializerConfig.isForceKryoAvroEnabled()).thenReturn(false);
            
            KryoSerializer<String> serializer = new KryoSerializer<>(type, serializerConfig);
            
            // Trigger the call chain
            serializer.createInstance();
            
        } finally {
            // Restore original logger
            logField.set(null, originalLogger);
        }
    }
}

