                org.slf4j.Logger.ROOT_LOGGER_NAME);
        ch.qos.logback.classic.Logger kryoLogger = 
            (ch.qos.logback.classic.Logger) LoggerFactory.getLogger(
                "org.apache.flink.api.java.typeutils.runtime.kryo.KryoSerializer");
        
        // Store original level
        ch.qos.logback.classic.Level originalRootLevel = rootLogger.getLevel();
        ch.qos.logback.classic.Level originalKryoLevel = kryoLogger.getLevel();
        
        try {
            // Set to TRACE level
            rootLogger.setLevel(ch.qos.logback.classic.Level.TRACE);
            kryoLogger.setLevel(ch.qos.logback.classic.Level.TRACE);
            
            // Create serializer instance
            SerializerConfig config = new SerializerConfigImpl();
            KryoSerializer<String> serializer = new KryoSerializer<>(String.class, config);
            
            // Create simple input/output views
            SimpleDataInputView inputView = new SimpleDataInputView(
                new InputStream() {
                    @Override
                    public int read() throws IOException {
                        return -1; // EOF immediately
                    }
                });
            
            SimpleDataOutputView outputView = new SimpleDataOutputView(
                new OutputStream() {
                    @Override
                    public void write(int b) throws IOException {
                        // Do nothing
                    }
                });
            
            // Call the entry point method
            serializer.copy(inputView, outputView);
            
        } finally {
            // Restore original logging levels
            if (originalRootLevel != null) {
                rootLogger.setLevel(originalRootLevel);
            }
            if (originalKryoLevel != null) {
                kryoLogger.setLevel(originalKryoLevel);
            }
        }
    }
