        class TestPojo {
            public String field1;
            public int field2;
        }
        
        // Create fields list for PojoTypeInfo constructor
        List<PojoField> fields = new ArrayList<>();
        
        // Get the String field
        try {
            Field stringField = TestPojo.class.getField("field1");
            TypeInformation<?> stringTypeInfo = TypeInformation.of(String.class);
            fields.add(new PojoField(stringField, stringTypeInfo));
        } catch (Exception e) {
            // Fallback if reflection fails
            throw new RuntimeException("Failed to create test fields", e);
        }
        
        // Create PojoTypeInfo instance
        PojoTypeInfo<TestPojo> pojoTypeInfo = new PojoTypeInfo<>(TestPojo.class, fields);
        
        // Create a mock SerializerConfig that returns true for isForceKryoEnabled()
        SerializerConfig config = Mockito.mock(SerializerConfig.class);
        Mockito.when(config.isForceKryoEnabled()).thenReturn(true);
        Mockito.when(config.isForceAvroEnabled()).thenReturn(false);
        
        // Enable TRACE logging on KryoSerializer's logger to trigger the path
        // We need to set the static LOG field to a trace-enabled logger
        try {
            Field logField = KryoSerializer.class.getDeclaredField("LOG");
            
            // Make the field accessible
            logField.setAccessible(true);
            
            // Get the field modifiers to remove final
            Field modifiersField = Field.class.getDeclaredField("modifiers");
            modifiersField.setAccessible(true);
            int originalModifiers = logField.getModifiers();
            modifiersField.setInt(logField, originalModifiers & ~Modifier.FINAL);
            
            // Create a trace-enabled logger
            Logger traceLogger = Mockito.mock(Logger.class);
            Mockito.when(traceLogger.isTraceEnabled()).thenReturn(true);
            Mockito.when(traceLogger.isDebugEnabled()).thenReturn(false);
            
            // Set the mock logger
            logField.set(null, traceLogger);
            
            // Also set the KryoSerializerDebugInitHelper to ensure CONCURRENT_ACCESS_CHECK is true
            Field debugHelperField = KryoSerializerDebugInitHelper.class.getDeclaredField("setToDebug");
            debugHelperField.setAccessible(true);
            Field debugModifiersField = Field.class.getDeclaredField("modifiers");
            debugModifiersField.setAccessible(true);
            int debugOriginalModifiers = debugHelperField.getModifiers();
            debugModifiersField.setInt(debugHelperField, debugOriginalModifiers & ~Modifier.FINAL);
            debugHelperField.set(null, true);
            
        } catch (Exception e) {
            // If reflection fails, we'll still try to execute the path
            // The static initializer might still trigger if the logger is already at TRACE level
        }
        
        // Call the entry point method - this should trigger the static initializer
        // which calls configureKryoLogging() which calls Log.setLogger()
        TypeSerializer<TestPojo> serializer = pojoTypeInfo.createSerializer(config);
    }
}

