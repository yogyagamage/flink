            // This will invoke ZipFile constructor during execution
            CompressionUtils.extractZipFileWithPermissions(
                tempZipFile.getAbsolutePath(), 
                tempTargetDir.getAbsolutePath()
            );
        } catch (IOException e) {
            // Expected since the zip file is empty/corrupted
            // The test's goal is just to reach the ZipFile constructor call
        }
    }
}

