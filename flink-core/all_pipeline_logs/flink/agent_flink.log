import java.io.IOException;
import java.nio.file.Files;

public class CompressionUtilsextractZipFileWithPermissions_ZipFilemethodFikaTest {

    @Test
    public void testExtractZipFileWithPermissionsInvokesZipFileConstructor() throws IOException {
        // Create a temporary zip file for the test
        File tempZipFile = File.createTempFile("test", ".zip");
        tempZipFile.deleteOnExit();
        
        // Create a temporary target directory
        File tempTargetDir = Files.createTempDirectory("flink-test").toFile();
        tempTargetDir.deleteOnExit();
        
