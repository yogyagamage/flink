import org.apache.flink.api.common.serialization.SerializerConfig;
import org.apache.flink.api.java.typeutils.runtime.kryo.KryoSerializer;
import org.junit.jupiter.api.Test;
import org.slf4j.LoggerFactory;

import java.lang.reflect.Field;

public class GenericTypeInfo_MinlogForwardermethod_LoggermethodFikaTest {

    @Test
    public void testCreateSerializerTriggersMinlogForwarderAndLogger() throws Exception {
        // Enable TRACE logging to trigger the path
        ch.qos.logback.classic.Logger rootLogger = 
            (ch.qos.logback.classic.Logger) LoggerFactory.getLogger(ch.qos.logback.classic.Logger.ROOT_LOGGER_NAME);
        ch.qos.logback.classic.Level originalLevel = rootLogger.getLevel();
        rootLogger.setLevel(ch.qos.logback.classic.Level.TRACE);
        
        try {
            // Create instance using provided constructor
            GenericTypeInfo<String> typeInfo = new GenericTypeInfo<>(String.class);
            
            // Create SerializerConfig with proper configuration to avoid NPE
            SerializerConfig config = new SerializerConfig();
            
            // Use reflection to set the forceAvroKryoEnabledOpt field to avoid NPE
            Field forceAvroKryoEnabledOptField = SerializerConfig.class.getDeclaredField("isForceAvroKryoEnabledOpt");
            forceAvroKryoEnabledOptField.setAccessible(true);
            forceAvroKryoEnabledOptField.set(config, org.apache.flink.util.TernaryBoolean.FALSE);
            
            // This should trigger the static initializer of KryoSerializer
            // which calls configureKryoLogging() -> new MinlogForwarder() -> new Log.Logger()
            typeInfo.createSerializer(config);
        } finally {
            // Restore original log level
            rootLogger.setLevel(originalLevel);
        }
    }
}

