        // remaining"
        count = fill(buffer, remaining, required - remaining);
        if (count == (-1)) {
            throw new KryoBufferUnderflowException("Buffer underflow.");
        }
        remaining += count;
    } while (remaining < required );
    limit = remaining;
    return remaining;
}
