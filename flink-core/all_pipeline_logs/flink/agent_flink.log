package org.apache.flink.util;

import org.apache.commons.compress.archivers.zip.ZipArchiveEntry;
import org.apache.commons.compress.archivers.zip.ZipFile;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;

import java.io.File;
import java.io.FileOutputStream;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.zip.ZipEntry;
import java.util.zip.ZipOutputStream;

public class CompressionUtilsextractZipFileWithPermissions_ZipArchiveEntryisUnixSymlinkFikaTest {

    @Test
    public void testExtractZipFileWithPermissionsInvokesIsUnixSymlink(@TempDir Path tempDir) throws IOException {
        // Create a zip file containing a symlink entry
        Path zipFilePath = tempDir.resolve("test.zip");
        Path targetDir = tempDir.resolve("target");
        
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(zipFilePath.toFile()))) {
            // Create a regular file entry
            ZipEntry fileEntry = new ZipEntry("regular.txt");
            zos.putNextEntry(fileEntry);
            zos.write("content".getBytes());
            zos.closeEntry();
            
            // Create a symlink entry - ZipArchiveEntry.isUnixSymlink() returns true for symlinks
            // We need to create a proper zip file that will be recognized by commons-compress
            // as containing a symlink. We'll create a zip file with Unix symlink attribute.
            ZipEntry symlinkEntry = new ZipEntry("link.txt");
            // Set external attributes to indicate a symlink (Unix file mode 0xA000)
            symlinkEntry.setExternalAttributes(0xA0000000L);
            zos.putNextEntry(symlinkEntry);
            zos.write("../regular.txt".getBytes()); // Symlink target
            zos.closeEntry();
        }
        
        // Create target directory
        Files.createDirectories(targetDir);
        
        // Call the entry point method
        CompressionUtils.extractZipFileWithPermissions(zipFilePath.toString(), targetDir.toString());
    }
}

