import org.junit.jupiter.api.Test;

import java.util.LinkedHashMap;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

class KryoSerializerconfigureKryoLogging_LogTRACEFikaTest {

    @Test
    void testConfigureKryoLoggingTriggersLogTRACE() throws Exception {
        // Create a mock SerializerConfig that will be used to construct KryoSerializer
        SerializerConfigImpl mockSerializerConfig = mock(SerializerConfigImpl.class);
        
        // Configure the mock to return empty collections/maps to avoid NPEs
        when(mockSerializerConfig.getDefaultKryoSerializers())
                .thenReturn(new LinkedHashMap<>());
        when(mockSerializerConfig.getDefaultKryoSerializerClasses())
                .thenReturn(new LinkedHashMap<>());
        when(mockSerializerConfig.getRegisteredKryoTypes())
                .thenReturn(new LinkedHashSet<>());
        when(mockSerializerConfig.getRegisteredTypesWithKryoSerializerClasses())
                .thenReturn(new LinkedHashMap<>());
        when(mockSerializerConfig.getRegisteredTypesWithKryoSerializers())
                .thenReturn(new LinkedHashMap<>());
        when(mockSerializerConfig.isForceKryoAvroEnabled())
                .thenReturn(false);
        
        // Set the logger to TRACE level so that LOG.isTraceEnabled() returns true
        // This is done via reflection since LOG is a private static final field
        java.lang.reflect.Field logField = KryoSerializer.class.getDeclaredField("LOG");
        logField.setAccessible(true);
        org.slf4j.Logger logger = (org.slf4j.Logger) logField.get(null);
        
        // Create a spy of the logger to control isTraceEnabled()
        org.slf4j.Logger spyLogger = org.mockito.Mockito.spy(logger);
        when(spyLogger.isTraceEnabled()).thenReturn(true);
        logField.set(null, spyLogger);
        
        try {
            // Instantiate KryoSerializer - this triggers static initializer which calls configureKryoLogging()
            // The constructor is the entry point specified in the requirements
            KryoSerializer<String> serializer = new KryoSerializer<>(
                String.class,
                mockSerializerConfig
            );
        } finally {
            // Restore original logger to avoid affecting other tests
            logField.set(null, logger);
        }
    }
}

