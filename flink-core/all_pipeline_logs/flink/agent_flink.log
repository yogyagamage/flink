package org.apache.flink.util;

import org.junit.jupiter.api.Test;
import org.apache.commons.compress.archivers.tar.TarArchiveEntry;
import org.apache.commons.compress.archivers.tar.TarArchiveInputStream;
import org.apache.commons.compress.compressors.gzip.GzipCompressorInputStream;
import java.io.BufferedInputStream;
import java.io.File;
import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.commons.compress.utils.IOUtils;
import java.io.ByteArrayInputStream;
import java.io.ByteArrayOutputStream;

public class CompressionUtilsunpackEntry_TarArchiveEntryisSymbolicLinkFikaTest {

    @Test
    public void testExtractTarFile() throws Exception {
        // Create a minimal tar file in memory that contains a symbolic link entry
        byte[] tarData = createTarWithSymbolicLink();
        
        // Write tar data to a temporary file
        File tempTarFile = File.createTempFile("test", ".tar");
        tempTarFile.deleteOnExit();
        Files.write(tempTarFile.toPath(), tarData);
        
        // Create temporary target directory
        File targetDir = Files.createTempDirectory("flink-test").toFile();
        targetDir.deleteOnExit();
        
        // Call the entry point method
        CompressionUtils.extractTarFile(tempTarFile.getAbsolutePath(), targetDir.getAbsolutePath());
    }
    
    private byte[] createTarWithSymbolicLink() throws IOException {
        ByteArrayOutputStream byteArrayOutputStream = new ByteArrayOutputStream();
        
        // Create tar archive output stream
        try (org.apache.commons.compress.archivers.tar.TarArchiveOutputStream tarOutput = 
                new org.apache.commons.compress.archivers.tar.TarArchiveOutputStream(byteArrayOutputStream)) {
            
            // Create a regular file entry
            TarArchiveEntry fileEntry = new TarArchiveEntry("regular-file.txt");
            fileEntry.setSize(5);
            tarOutput.putArchiveEntry(fileEntry);
            tarOutput.write("hello".getBytes());
            tarOutput.closeArchiveEntry();
            
            // Create a symbolic link entry - this will trigger isSymbolicLink() call
            TarArchiveEntry symlinkEntry = new TarArchiveEntry("link-to-file.txt", 
                org.apache.commons.compress.archivers.tar.TarConstants.LF_SYMLINK);
            symlinkEntry.setLinkName("regular-file.txt");
            tarOutput.putArchiveEntry(symlinkEntry);
            tarOutput.closeArchiveEntry();
        }
        
        return byteArrayOutputStream.toByteArray();
    }
}

