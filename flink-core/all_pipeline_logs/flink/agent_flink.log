package org.apache.flink.api.java.typeutils;

import org.apache.flink.api.common.serialization.SerializerConfig;
import org.apache.flink.api.java.typeutils.runtime.kryo.KryoSerializer;
import org.junit.jupiter.api.Test;
import org.slf4j.LoggerFactory;
import ch.qos.logback.classic.Level;
import ch.qos.logback.classic.Logger;

public class GenericTypeInfo_KryoSerializerconfigureKryoLogging_LogsetLoggerFikaTest {

    @Test
    public void testCreateSerializerTriggersKryoLoggingConfiguration() throws Exception {
        // Set TRACE logging level for KryoSerializer to trigger the Log.setLogger call
        Logger kryoLogger = (Logger) LoggerFactory.getLogger(KryoSerializer.class);
        Level originalLevel = kryoLogger.getLevel();
        kryoLogger.setLevel(Level.TRACE);

        try {
            // Create instance of GenericTypeInfo
            GenericTypeInfo<String> genericTypeInfo = new GenericTypeInfo<>(String.class);
            
            // Create SerializerConfig with generic types enabled (default)
            SerializerConfig config = new SerializerConfig();
            
            // This call should trigger the static initializer of KryoSerializer
            // which calls configureKryoLogging(), which calls Log.setLogger()
            genericTypeInfo.createSerializer(config);
        } finally {
            // Restore original logging level
            kryoLogger.setLevel(originalLevel);
        }
    }
}

