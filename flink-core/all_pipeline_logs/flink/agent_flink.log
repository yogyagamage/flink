    public void testExtractTarFileTriggersGetDirectoryEntries() throws IOException {
        // Create a minimal tar file with a directory entry
        File tarFile = new File(tempDir, "test.tar");
        try (OutputStream os = Files.newOutputStream(tarFile.toPath())) {
            // Write minimal tar header for an empty directory
            // Tar header format: 512 bytes per entry
            byte[] header = new byte[512];
            
            // Directory entry: typeflag '5'
            header[156] = '5';
            
            // Directory name: "testdir/"
            byte[] nameBytes = "testdir/".getBytes();
            System.arraycopy(nameBytes, 0, header, 0, Math.min(nameBytes.length, 100));
            
            // Mode: 0755
            String mode = "0000755";
            byte[] modeBytes = mode.getBytes();
            System.arraycopy(modeBytes, 0, header, 100, modeBytes.length);
            
            // UID/GID: 0
            String uid = "0000000";
            byte[] uidBytes = uid.getBytes();
            System.arraycopy(uidBytes, 0, header, 108, uidBytes.length);
            
            String gid = "0000000";
            byte[] gidBytes = gid.getBytes();
            System.arraycopy(gidBytes, 0, header, 116, gidBytes.length);
            
            // Size: 0 for directory
            String size = "00000000000";
            byte[] sizeBytes = size.getBytes();
            System.arraycopy(sizeBytes, 0, header, 124, sizeBytes.length);
            
            // Modification time: current time
            String mtime = "00000000000";
            byte[] mtimeBytes = mtime.getBytes();
            System.arraycopy(mtimeBytes, 0, header, 136, mtimeBytes.length);
            
            // Checksum: calculate and write
            int checksum = 0;
            for (int i = 0; i < 512; i++) {
                checksum += (i >= 148 && i < 156) ? 32 : (header[i] & 0xFF);
            }
            String checksumStr = String.format("%06o", checksum);
            byte[] checksumBytes = (checksumStr + "\0 ").getBytes();
            System.arraycopy(checksumBytes, 0, header, 148, Math.min(checksumBytes.length, 8));
            
            os.write(header);
            
            // Write two blocks of zeros (end of tar)
            byte[] zeros = new byte[1024];
            os.write(zeros);
        }

        // Create target directory
        File targetDir = new File(tempDir, "extract");
        
        // This should trigger the call chain ending with TarArchiveEntry.getDirectoryEntries()
        extractTarFile(tarFile.getAbsolutePath(), targetDir.getAbsolutePath());
    }
